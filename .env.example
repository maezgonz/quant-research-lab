# Environment variables for quant-research-lab
# Copy to .env and fill in what you need. Every key is optional per-module.

# Market data
ALPHAVANTAGE_API_KEY=          # https://www.alphavantage.co/support/#api-key (free)
NASDAQ_DATA_LINK_API_KEY=      # https://data.nasdaq.com/ account
FMP_API_KEY=                   # https://financialmodelingprep.com/
NEWS_API_KEY=                  # https://newsapi.org/account

# Google Sheets (sheet must be "Published to the web")
SPREADSHEET_ID=

# Misc
MAE_API_KEY=
